<Window x:Class="Connectfon.UI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Connectfon" Width="1180" Height="760" MinWidth="980" MinHeight="650"
 Background="#081018" Foreground="White" WindowStartupLocation="CenterScreen">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="#14202B" CornerRadius="16" Padding="16">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="CONNECTFON" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="Bluetooth: initializing…" Foreground="#91A5B5" Margin="0,3,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="Volume" VerticalAlignment="Center" Margin="8"/><Slider x:Name="VolumeSlider" Width="150" Minimum="0" Maximum="1" ValueChanged="Volume_Changed"/>
      <CheckBox x:Name="MuteBox" Content="Mute" VerticalAlignment="Center" Margin="10" Checked="Mute_Changed" Unchecked="Mute_Changed"/>
      <Button Content="Refresh" Click="Refresh_Click"/><Button Content="Diagnostics" Click="Diagnostics_Click"/>
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Row="1" Margin="0,16,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="3.9*"/></Grid.ColumnDefinitions>
   <Border Background="#14202B" CornerRadius="16" Padding="14" Margin="0,0,10,0">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Bluetooth phones" FontSize="22"/>
      <TextBlock Text="Select a phone to inspect profiles and use it as the head-unit" Foreground="#91A5B5" TextWrapping="Wrap" Margin="0,4,0,10"/>
     </StackPanel>
     <ListBox x:Name="DevicesList" SelectionChanged="DevicesList_SelectionChanged" Background="Transparent" BorderThickness="0">
      <ListBox.ItemTemplate><DataTemplate>
       <Border Padding="12" Margin="2,3" Background="#1D2A36" CornerRadius="10">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="{Binding Name}" FontSize="18"/><TextBlock Text="{Binding State}" Foreground="#91A5B5"/><TextBlock Text="{Binding Address}" Foreground="#617786" FontSize="11"/></StackPanel>
         <TextBlock Grid.Column="1" Text="{Binding ProfileText}" Foreground="#55D6B0" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>
       </Border>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>

   <Border Grid.Column="1" Background="#14202B" CornerRadius="16" Padding="18">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock x:Name="PhoneTitle" Text="No phone selected" FontSize="26" FontWeight="Bold"/>
      <TextBlock x:Name="CapabilitiesText" Text="Select a Bluetooth device" Foreground="#91A5B5" Margin="0,5,0,0"/>
     </StackPanel>
     <Button Grid.Column="1" Content="Connect HFP" Click="ConnectHfp_Click" Margin="8,0,0,0"/>
     
     <Border Grid.Row="1" Grid.ColumnSpan="2" x:Name="CallBanner" Background="#244C45" CornerRadius="12" Padding="14" Margin="0,14,0,10" Visibility="Collapsed">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock x:Name="CallTitle" Text="Incoming call" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="CallNumber" Foreground="#BBDAD3"/></StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="AnswerButton" Content="Answer" Click="Answer_Click"/><Button Content="Hang up" Click="Hangup_Click"/></StackPanel>
      </Grid>
     </Border>

     <TabControl Grid.Row="2" Grid.ColumnSpan="2">
      <TabItem Header="Dial">
       <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBox x:Name="NumberBox" FontSize="30" Padding="10" HorizontalContentAlignment="Right"/>
        <UniformGrid Grid.Row="1" Columns="3" Rows="4" Margin="0,12">
         <Button Content="1" Click="Digit_Click"/><Button Content="2" Click="Digit_Click"/><Button Content="3" Click="Digit_Click"/>
         <Button Content="4" Click="Digit_Click"/><Button Content="5" Click="Digit_Click"/><Button Content="6" Click="Digit_Click"/>
         <Button Content="7" Click="Digit_Click"/><Button Content="8" Click="Digit_Click"/><Button Content="9" Click="Digit_Click"/>
         <Button Content="*" Click="Digit_Click"/><Button Content="0" Click="Digit_Click"/><Button Content="#" Click="Digit_Click"/>
        </UniformGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
         <Button Content="Call" Click="Call_Click" MinWidth="120"/><Button Content="Backspace" Click="Backspace_Click"/><Button Content="Hang up" Click="Hangup_Click" MinWidth="120"/>
        </StackPanel>
       </Grid>
      </TabItem>
      <TabItem Header="Contacts">
       <DockPanel Margin="10"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="Load phonebook" Click="Contacts_Click"/><TextBox x:Name="ContactSearch" Width="220" Margin="5" TextChanged="ContactSearch_Changed" VerticalContentAlignment="Center"/></StackPanel>
        <ListBox x:Name="ContactsList" Margin="0,10,0,0" MouseDoubleClick="Contact_DoubleClick"><ListBox.ItemTemplate><DataTemplate><Grid Padding="7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="17"/><TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="#91A5B5"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
       </DockPanel>
      </TabItem>
      <TabItem Header="Recent">
       <DockPanel Margin="10"><Button DockPanel.Dock="Top" Content="Load call history" Click="Recent_Click"/><ListBox x:Name="RecentList" Margin="0,10,0,0" MouseDoubleClick="Recent_DoubleClick"><ListBox.ItemTemplate><DataTemplate><Grid Padding="7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="17"/><TextBlock Text="{Binding Number}" Foreground="#91A5B5"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Type}" HorizontalAlignment="Right"/><TextBlock Text="{Binding Time}" Foreground="#718391"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
      </TabItem>
      <TabItem Header="Diagnostics"><TextBox x:Name="DiagnosticsBox" Margin="10" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0D151C" Foreground="#BBD0DC"/></TabItem>
     </TabControl>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>