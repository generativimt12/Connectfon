<Window x:Class="Connectfon.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Connectfon" Width="1100" Height="720" Background="#0B1117" Foreground="White" WindowStartupLocation="CenterScreen">
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Background="#16202A" CornerRadius="12" Padding="16"><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="CONNECTFON" FontSize="26" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="Bluetooth: initializing…" Foreground="#9FB0BD"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Refresh" Click="Refresh_Click"/><Button Content="Diagnostics" Click="Diagnostics_Click"/></StackPanel></DockPanel></Border>
<Grid Grid.Row="1" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
<Border Background="#16202A" CornerRadius="12" Padding="14" Margin="0,0,10,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Bluetooth phones" FontSize="22" Margin="0,0,0,10"/><ListBox x:Name="DevicesList" SelectionChanged="DevicesList_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="White"><ListBox.ItemTemplate><DataTemplate><Border Padding="10" Margin="2" Background="#202C37" CornerRadius="8"><StackPanel><TextBlock Text="{Binding Name}" FontSize="18"/><TextBlock Text="{Binding State}" Foreground="#9FB0BD"/><TextBlock Text="{Binding Address}" Foreground="#718391" FontSize="12"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
<Border Grid.Column="1" Background="#16202A" CornerRadius="12" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="PhoneTitle" Text="No phone selected" FontSize="26" FontWeight="Bold"/><TextBlock x:Name="CapabilitiesText" Grid.Row="1" Text="Select a Bluetooth device" Foreground="#9FB0BD" Margin="0,6,0,18"/><TabControl Grid.Row="2"><TabItem Header="Dial"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox x:Name="NumberBox" FontSize="30" Padding="10" HorizontalContentAlignment="Right"/><UniformGrid Grid.Row="1" Columns="3" Rows="4" Margin="0,12"><Button Content="1" Click="Digit_Click"/><Button Content="2" Click="Digit_Click"/><Button Content="3" Click="Digit_Click"/><Button Content="4" Click="Digit_Click"/><Button Content="5" Click="Digit_Click"/><Button Content="6" Click="Digit_Click"/><Button Content="7" Click="Digit_Click"/><Button Content="8" Click="Digit_Click"/><Button Content="9" Click="Digit_Click"/><Button Content="*" Click="Digit_Click"/><Button Content="0" Click="Digit_Click"/><Button Content="#" Click="Digit_Click"/></UniformGrid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Call" Click="Call_Click"/><Button Content="Backspace" Click="Backspace_Click"/><Button Content="Hang up" Click="Hangup_Click"/></StackPanel></Grid></TabItem><TabItem Header="Contacts"><DockPanel Margin="10"><Button DockPanel.Dock="Top" Content="Load phonebook" Click="Contacts_Click"/><ListBox x:Name="ContactsList" Margin="0,10,0,0" DisplayMemberPath="Name"/></DockPanel></TabItem><TabItem Header="Recent"><TextBlock Margin="12" TextWrapping="Wrap" Text="Call history is exposed when the phone provides it through PBAP. Use Diagnostics to see detected profiles."/></TabItem></TabControl></Grid></Border></Grid></Grid>
</Window>
